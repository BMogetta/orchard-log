# Copy to `.env.local` (git-ignored) to sync the app against a CouchDB while
# developing. Leave it unset and the app stays purely local-first — no network.
#
# The URL includes the database name and, for local dev, basic-auth credentials
# matching docker-compose.yml. Production credentials never live in the repo.
VITE_COUCHDB_URL=http://admin:password@localhost:5984/orchard
